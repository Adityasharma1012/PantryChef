# ==============================================================================
# PantryChef Environment Configuration
# ==============================================================================

# Google Gemini API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
# Keep this empty or unset to run in missing-key mode (server returns GEMINI_KEY_MISSING)
# or set USE_MOCK_GEMINI=true for testing without an API key.
GEMINI_API_KEY=

# Gemini Model Name
# Recommended fast text model: gemini-3.5-flash
# Default is gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash

# Backend Server Port
PORT=3001

# Mock Mode (true / false)
# When set to true, the server uses MockRecipeGenerator instead of calling the Gemini API.
# Useful for local testing, demoing, and automated test runs without consuming API quota.
USE_MOCK_GEMINI=false

# Client URL (for CORS restriction in production)
CLIENT_ORIGIN=http://localhost:5173
